# FastCourt Next - copy to .env.local for optional cloud mode
# Local-only mode works without these variables.

# Practice Live WebSocket
# Local `npm run dev:live` (separate WS port):
NEXT_PUBLIC_LIVE_WS_MODE=port
NEXT_PUBLIC_LIVE_WS_PORT=3001
# Coolify / Railway / `node server.js`: omit MODE=port (uses same host /practice-live)
# Optional full override:
# NEXT_PUBLIC_LIVE_WS_URL=wss://your-app.up.railway.app/practice-live


# Supabase (cloud auth + sync) — optional
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase service role (server-only — Stripe webhook, admin profile sync)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (production billing webhook)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# OpenAI — Film Room "Analyze clip" (vision). Server-only.
OPENAI_API_KEY=sk-YOUR_KEY
# Optional override (default: gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o-mini

# App metadata
NEXT_PUBLIC_APP_BUILD=next-v8
NEXT_PUBLIC_ADMIN_EMAIL=admin@fastcourt.eu
NEXT_PUBLIC_MASTER_ADMIN_EMAIL=admin@fastcourt.eu
# Comma-separated emails that become master admin on signup
NEXT_PUBLIC_ADMIN_EMAILS=admin@fastcourt.eu
# Local/demo mode password for master admin emails (Coolify without Supabase)
NEXT_PUBLIC_LOCAL_ADMIN_PASSWORD=FastCourt-Admin-2026!
